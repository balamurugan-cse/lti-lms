# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Production Database & Authentication Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/lti_edutech_lms?schema=public
JWT_ACCESS_SECRET=your_jwt_access_secret_minimum_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_characters
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000

# Private Object Storage (S3-Compatible)
STORAGE_ENDPOINT=s3.amazonaws.com
STORAGE_BUCKET=lti-lms-private-assets
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Email Delivery & Notifications
EMAIL_PROVIDER_API_KEY=
ENCRYPTION_KEY=

